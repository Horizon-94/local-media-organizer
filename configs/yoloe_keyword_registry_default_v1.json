{
  "contract": "media_archive_yoloe_keyword_registry_v1",
  "registry_name": "YOLOE A/B 通用关键词注册表",
  "schema_version": "2026-07-04-ocr-trigger-v1.0",
  "description": "安装包内置基线。设置页只覆盖 A_CORE_CLASSES、B_EXTENDED_CLASSES 和 B 层启用状态；其余路由规则保持冻结。",
  "layers": {
    "A_CORE": {
      "zh": "A层主检索词",
      "default_run": true,
      "evidence_level": "strong",
      "used_by": [
        "YOLOE"
      ],
      "description": "默认运行。适合作为结构化强证据的目标、物体、场景实体。"
    },
    "B_EXTENDED": {
      "zh": "B层扩展辅助词",
      "default_run": false,
      "evidence_level": "weak_or_optional",
      "used_by": [
        "YOLOE",
        "Qwen-VL"
      ],
      "description": "默认不跑。按项目需要启用，或作为低权重辅助证据。"
    },
    "C_DELEGATED": {
      "zh": "C层委托概念",
      "default_run": false,
      "evidence_level": "delegated",
      "used_by": [
        "Qwen-VL",
        "OCR",
        "color_analysis",
        "visual_embedding"
      ],
      "description": "不交给 YOLOE 主检。交给视觉语言模型、OCR、颜色分析或向量检索。"
    },
    "OCR_TRIGGER_POLICY": {
      "zh": "OCR触发策略层",
      "default_run": true,
      "evidence_level": "routing_signal_not_visual_score",
      "used_by": [
        "YOLOE",
        "OCR"
      ],
      "description": "不属于普通视觉证据层。YOLOE只跑一次时，与A_CORE合并进入prompt；命中后只用于生成OCR队列，不参与Qwen-VL高价值帧正向选择。"
    }
  },
  "defaults": {
    "YOLOE_A_CORE": {
      "conf": 0.25,
      "imgsz": 640,
      "save_images": false,
      "save_txt": true,
      "strong_evidence": true
    },
    "YOLOE_B_EXTENDED": {
      "conf": 0.25,
      "imgsz": 640,
      "save_images": false,
      "save_txt": true,
      "strong_evidence": false
    }
  },
